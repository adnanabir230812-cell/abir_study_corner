<%- include('partials/header') %>

<%
  const currentTermId = locals.activeTerm || '4-1';
  const currentTermObj = locals.activeTermObj || { id: '4-1', name: 'Term 4-1', fullTitle: 'Year 4 • Term 1', bnTitle: '৪র্থ বর্ষ • ১ম টার্ম (চলমান টার্ম)', codeSeries: '4100 Series', status: 'current' };
  const allTermsList = locals.termsOverview || [];
  const term32Summary = allTermsList.find(t => t.id === '3-2') || { coursesCount: 5, questionsCount: 454, topicsCount: 18 };
%>

<!-- 1. MULTI-SEMESTER QUICK SWITCHER RIBBON (1-1 to 4-2) -->
<div class="mb-8 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-3 sm:p-4 shadow-sm">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-3">
    <div class="flex items-center justify-between sm:justify-start gap-2.5">
      <span class="text-xs font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400 px-2">
        Academic Semesters:
      </span>
      <button type="button" onclick="openTermModal()" class="lg:hidden text-xs font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-slate-700 px-3 py-1 rounded-lg">
        Term Portal &rarr;
      </button>
    </div>

    <div class="flex items-center gap-1.5 overflow-x-auto pb-1 lg:pb-0">
      <% allTermsList.forEach(t => { 
           const isActive = currentTermId === t.id;
           const isCurrent41 = t.id === '4-1';
      %>
        <a href="/?term=<%= t.id %>" class="flex-shrink-0 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-extrabold font-mono-code transition-all duration-200 <%= isActive ? (isCurrent41 ? 'bg-gradient-to-r from-amber-500 to-orange-500 text-slate-950 shadow-md shadow-amber-500/20' : 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md shadow-indigo-500/20') : 'bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-700 hover:text-indigo-600 dark:hover:text-indigo-400' %>">
          <span><%= t.id %></span>
          <% if (isCurrent41) { %>
            <span class="text-[9px] px-1.5 py-0.2 rounded-full uppercase font-black <%= isActive ? 'bg-slate-950/20 text-slate-950' : 'bg-amber-500/20 text-amber-700 dark:text-amber-300' %>">Now</span>
          <% } else if (t.coursesCount > 0) { %>
            <span class="text-[9px] px-1.5 py-0.2 rounded-full font-black <%= isActive ? 'bg-white/20 text-white' : 'bg-indigo-500/15 text-indigo-600 dark:text-indigo-400' %>"><%= t.coursesCount %></span>
          <% } %>
        </a>
      <% }) %>

      <a href="/?term=all" class="flex-shrink-0 inline-flex items-center gap-1 px-3.5 py-1.5 rounded-xl text-xs font-extrabold transition-all duration-200 <%= currentTermId === 'all' ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white shadow-md' : 'bg-slate-100 dark:bg-slate-700/80 text-slate-600 dark:text-slate-300 hover:bg-indigo-50 dark:hover:bg-slate-700' %>">
        <span>All Terms</span>
      </a>
    </div>
  </div>
</div>

<!-- Mobile Search Block -->
<div class="block md:hidden mb-6 relative">
  <form action="/search" method="GET">
    <input type="text" name="q" id="mobile-search-input" autocomplete="off" placeholder="Search courses, topics..." 
      class="block w-full px-4 py-3 border border-slate-200 dark:border-slate-700 rounded-xl bg-white dark:bg-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-all shadow-sm">
  </form>
  <div id="mobile-search-results-dropdown" class="absolute left-0 right-0 mt-2 w-full bg-white dark:bg-slate-800 rounded-xl shadow-xl border border-slate-200 dark:border-slate-700 max-h-96 overflow-y-auto hidden z-50"></div>
</div>

<!-- 2. TOP HERO ZONE: Active Semester Banner, Live Countdown & Motivation -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-10 items-start">
  
  <!-- Left Side (2/3 width): Semester Hero + Countdown + Daily Motivation -->
  <div class="lg:col-span-2 flex flex-col justify-start gap-6">
    
    <!-- Rich Dark Indigo Hero Banner -->
    <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 sm:p-8 text-white shadow-xl relative overflow-hidden border border-indigo-500/20">
      <div class="absolute -right-10 -bottom-10 w-48 h-48 bg-indigo-500 rounded-full blur-3xl opacity-15 pointer-events-none"></div>
      <div class="absolute -left-10 -top-10 w-48 h-48 bg-pink-500 rounded-full blur-3xl opacity-10 pointer-events-none"></div>

      <div class="relative z-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <% if (currentTermId === '4-1') { %>
              <span class="inline-block px-3 py-1 rounded-full text-[10px] font-black bg-amber-500 text-slate-950 uppercase tracking-widest">
                Current Active Term &bull; এইবারের টার্ম
              </span>
            <% } else if (currentTermId === '3-2') { %>
              <span class="inline-block px-3 py-1 rounded-full text-[10px] font-black bg-indigo-500/25 text-indigo-200 border border-indigo-400/30 uppercase tracking-widest">
                Previous Term &bull; Completed Archive
              </span>
            <% } else { %>
              <span class="inline-block px-3 py-1 rounded-full text-[10px] font-black bg-white/10 text-indigo-200 border border-white/15 uppercase tracking-widest">
                <%= currentTermObj.badgeText || 'Academic Semester' %>
              </span>
            <% } %>
            <span class="text-xs font-mono-code font-bold text-indigo-200 bg-white/10 px-2.5 py-1 rounded-full border border-white/10">
              <%= currentTermObj.codeSeries %>
            </span>
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-white mt-3 tracking-tight font-display">
            <%= currentTermObj.name %> <span class="text-indigo-300 font-bold text-lg sm:text-2xl block sm:inline sm:ml-2">(<%= currentTermObj.bnTitle %>)</span>
          </h1>
          <p class="text-indigo-100/80 text-xs sm:text-sm mt-2 max-w-xl leading-relaxed">
            <% if (currentTermId === '4-1') { %>
              ৪র্থ বর্ষ ১ম সেমিস্টার (<strong>Term 4-1</strong>)-এর ড্যাশবোর্ডে স্বাগতম। আগের <strong>3-2</strong> টার্মের সব কোর্স ও ৪৫৪টি প্রশ্নোত্তর আর্কাইভে সংরক্ষিত আছে।
            <% } else if (currentTermId === '3-2') { %>
              আগের টার্ম (<strong>Term 3-2</strong>)-এর সম্পূর্ণ আর্কাইভ &mdash; ৫টি কোর্সের সব লেকচার নোট, টপিক ও ৪৫৪টি ভেরিফায়েড প্রশ্নোত্তর।
            <% } else { %>
              <strong><%= currentTermObj.fullTitle %></strong> (<%= currentTermObj.bnTitle %>)-এর ডেডিকেটেড স্টাডি ভল্ট।
            <% } %>
          </p>
        </div>

        <div class="flex sm:flex-col gap-2.5 flex-shrink-0">
          <button type="button" onclick="openTermModal()" class="px-4 py-2.5 rounded-xl text-xs font-extrabold bg-white text-slate-900 hover:bg-indigo-50 transition-all shadow-md cursor-pointer text-center">
            Change Term
          </button>
          <% if (currentTermId !== '3-2') { %>
            <a href="/?term=3-2" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-indigo-500/25 hover:bg-indigo-500/40 text-indigo-200 border border-indigo-400/30 transition-all text-center">
              3-2 Archive (<%= term32Summary.coursesCount %>)
            </a>
          <% } else { %>
            <a href="/?term=4-1" class="px-4 py-2.5 rounded-xl text-xs font-bold bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-400/30 transition-all text-center">
              Go to 4-1 (Current)
            </a>
          <% } %>
        </div>
      </div>
    </div>

    <!-- Live Countdown Banner (when upcoming exams exist) -->
    <% if (exams && exams.length > 0) { 
        const now = new Date();
        const upcomingExams = exams.filter(e => new Date(e.examDate) > now);
        const nextExam = upcomingExams.length > 0 ? upcomingExams[0] : null;
        
        let warningMessage = "";
        let warningClass = "";
        
        const toBn = (num) => {
          const bnNums = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
          return num.toString().replace(/\d/g, d => bnNums[d]);
        };
        
        if (nextExam) {
          const examDate = new Date(nextExam.examDate);
          const diffTime = examDate - now;
          const diffHours = Math.floor((diffTime % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
          const diffMinutes = Math.floor((diffTime % (1000 * 60 * 60)) / (1000 * 60));
          
          const isToday = examDate.getDate() === now.getDate() && 
                          examDate.getMonth() === now.getMonth() && 
                          examDate.getFullYear() === now.getFullYear();
                          
          const tomorrow = new Date(now);
          tomorrow.setDate(now.getDate() + 1);
          const isTomorrow = examDate.getDate() === tomorrow.getDate() && 
                             examDate.getMonth() === tomorrow.getMonth() && 
                             examDate.getFullYear() === tomorrow.getFullYear();
          
          if (isToday) {
            warningMessage = "পরীক্ষা আজই! সব পড়া বন্ধ করে দ্রুত ফাইনাল রিভিশন দাও! আল্লাহ সহায় হোন।";
            warningClass = "bg-rose-500/10 border-rose-500/20 text-rose-300 font-black";
          } else if (isTomorrow) {
            warningMessage = `মাত্র ১ দিন (বা ${toBn(diffHours)} ঘণ্টা ${toBn(diffMinutes)} মিনিট) বাকি! মোবাইল দূরে রাখো এবং এখনই পড়তে বসো!`;
            warningClass = "bg-rose-500/20 border-rose-500/30 text-rose-200 font-extrabold";
          } else {
            const examDateDay = new Date(examDate.getFullYear(), examDate.getMonth(), examDate.getDate());
            const todayDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const calendarDiffDays = Math.round((examDateDay - todayDay) / (1000 * 60 * 60 * 24));
            
            if (calendarDiffDays <= 3) {
              warningMessage = `আর মাত্র ${toBn(calendarDiffDays)} দিন বাকি! অবহেলা একদম বন্ধ করো! সব সিলেবাস শেষ করেছ তো?`;
              warningClass = "bg-amber-500/10 border-amber-500/20 text-amber-200 font-bold";
            } else if (calendarDiffDays <= 7) {
              warningMessage = `আর মাত্র ${toBn(calendarDiffDays)} দিন বাকি! পড়া ফেলে রেখো না, এখনই রিভিশন শেষ করো!`;
              warningClass = "bg-yellow-500/10 border-yellow-500/20 text-yellow-200 font-semibold";
            } else if (calendarDiffDays <= 14) {
              warningMessage = `পরীক্ষার আর মাত্র ${toBn(calendarDiffDays)} দিন বাকি! অলসতা দূর করো, সময় নষ্ট কোরো না!`;
              warningClass = "bg-indigo-500/10 border-indigo-500/20 text-indigo-200 font-medium";
            } else {
              warningMessage = `পরীক্ষার আর ${toBn(calendarDiffDays)} দিন বাকি। রুটিন মাফিক নিয়মিত পড়াশোনা করো!`;
              warningClass = "bg-emerald-500/10 border-emerald-500/20 text-emerald-300 font-medium";
            }
          }
        }
    %>
      <% if (nextExam) { %>
        <div class="bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900 rounded-3xl p-6 md:p-8 text-white shadow-xl relative overflow-hidden border border-indigo-500/20 flex flex-col gap-6 w-full">
          <div class="relative z-10 flex flex-col md:flex-row md:items-center md:justify-between gap-6">
            <div>
              <span class="inline-block px-2.5 py-1 rounded-md text-[10px] font-bold bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 uppercase tracking-widest">
                Next Exam Countdown
              </span>
              <h2 class="text-2xl md:text-3xl font-extrabold text-white mt-3 tracking-tight font-display"><%= nextExam.subjectName %></h2>
              <p class="text-indigo-200/80 text-xs mt-1">
                Scheduled: <strong><%= new Date(nextExam.examDate).toLocaleDateString(undefined, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></strong>
              </p>
            </div>
            
            <div class="flex items-center gap-2.5 sm:gap-3.5 select-none font-mono-code" id="exam-countdown" data-date="<%= nextExam.examDate %>">
              <div class="flex flex-col items-center bg-white/10 backdrop-blur-md rounded-xl p-2.5 w-14 sm:w-16 border border-white/15">
                <span class="text-xl sm:text-2xl font-black tracking-tight" id="cd-days">00</span>
                <span class="text-[9px] font-bold text-indigo-200 uppercase mt-0.5">Days</span>
              </div>
              <div class="flex flex-col items-center bg-white/10 backdrop-blur-md rounded-xl p-2.5 w-14 sm:w-16 border border-white/15">
                <span class="text-xl sm:text-2xl font-black tracking-tight" id="cd-hours">00</span>
                <span class="text-[9px] font-bold text-indigo-200 uppercase mt-0.5">Hours</span>
              </div>
              <div class="flex flex-col items-center bg-white/10 backdrop-blur-md rounded-xl p-2.5 w-14 sm:w-16 border border-white/15">
                <span class="text-xl sm:text-2xl font-black tracking-tight" id="cd-minutes">00</span>
                <span class="text-[9px] font-bold text-indigo-200 uppercase mt-0.5">Mins</span>
              </div>
              <div class="flex flex-col items-center bg-indigo-600/50 backdrop-blur-md rounded-xl p-2.5 w-14 sm:w-16 border border-indigo-500/20">
                <span class="text-xl sm:text-2xl font-black tracking-tight text-indigo-300" id="cd-seconds">00</span>
                <span class="text-[9px] font-bold text-indigo-200 uppercase mt-0.5">Secs</span>
              </div>
            </div>
          </div>

          <div class="relative z-10 p-4 rounded-2xl border text-sm <%= warningClass %>">
            <p class="leading-relaxed"><%= warningMessage %></p>
          </div>
        </div>
      <% } %>
    <% } %>

    <!-- Daily Islamic Motivation Quote Card -->
    <% if (locals.quote) { %>
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-3xl p-6 shadow-sm transition-all hover:shadow-md relative overflow-hidden w-full border-l-4 border-l-emerald-500">
        <div class="absolute right-0 top-0 w-28 h-28 bg-emerald-500/5 rounded-full blur-2xl pointer-events-none"></div>
        <span class="text-[10px] font-extrabold text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/50 px-2.5 py-1 rounded-md uppercase tracking-widest border border-emerald-200/50 dark:border-emerald-800/50">
          Daily Islamic Motivation
        </span>
        <p class="text-slate-800 dark:text-slate-100 font-semibold text-base sm:text-lg mt-3 italic leading-relaxed">
          "<%= quote.text %>"
        </p>
        <p class="text-slate-400 dark:text-slate-500 text-xs font-bold mt-2">
          &mdash; <%= quote.source %>
        </p>
      </div>
    <% } %>

  </div>

  <!-- Right Side (1/3 width): Exam Routine Styled as Premium Planner Cards -->
  <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-3xl p-6 shadow-sm flex flex-col justify-start">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100 dark:border-slate-700 mb-5">
      <h2 class="text-lg font-extrabold text-slate-900 dark:text-white font-display">
        Exam Routine (<%= currentTermId === 'all' ? 'All' : currentTermId %>)
      </h2>
      <span class="text-[10px] font-bold text-indigo-600 dark:text-indigo-400 px-2.5 py-0.5 bg-indigo-50 dark:bg-indigo-950/50 rounded-full border border-indigo-100 dark:border-indigo-900 uppercase tracking-wider">
        Planner
      </span>
    </div>

    <% if (!exams || exams.length === 0) { %>
      <div class="py-10 px-4 text-center rounded-2xl bg-slate-50/70 dark:bg-slate-900/40 border border-dashed border-slate-200 dark:border-slate-700">
        <span class="inline-block px-3 py-1 rounded-full text-[10px] font-mono-code font-bold bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 uppercase tracking-wider mb-2">
          Term <%= currentTermId %> Schedule
        </span>
        <h3 class="text-sm font-extrabold text-slate-800 dark:text-slate-200">
          No Exams Scheduled Yet
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-1 leading-relaxed">
          <% if (currentTermId === '4-1') { %>
            ৪-১ টার্মের পরীক্ষার রুটিন প্রকাশিত হলে এখানে তারিখ ও লাইভ কাউন্টডাউন যুক্ত হবে।
          <% } else { %>
            এই সেমিস্টারের কোনো পরীক্ষার তারিখ এখনো যুক্ত করা হয়নি।
          <% } %>
        </p>
        <% if (currentTermId !== '3-2') { %>
          <a href="/?term=3-2" class="mt-4 inline-block text-xs font-extrabold text-indigo-600 dark:text-indigo-400 hover:underline">
            View Term 3-2 Archive &rarr;
          </a>
        <% } %>
      </div>
    <% } else { %>
      <div class="relative space-y-3.5 w-full">
        <% 
          const now = new Date();
          exams.forEach((exam) => {
            const examDate = new Date(exam.examDate);
            const examDateDay = new Date(examDate.getFullYear(), examDate.getMonth(), examDate.getDate());
            const todayDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const diffDays = Math.round((examDateDay - todayDay) / (1000 * 60 * 60 * 24));
            
            const monthShort = examDate.toLocaleDateString(undefined, { month: 'short' });
            const dayNum = examDate.getDate();
            
            let statusText = '';
            let statusClass = '';
            let cardBorderClass = 'border-slate-100 dark:border-slate-700/60 hover:border-slate-200 dark:hover:border-slate-600';
            let calendarBgClass = 'bg-slate-50 dark:bg-slate-900 border-slate-100 dark:border-slate-700';
            let calendarHeaderClass = 'bg-slate-200 dark:bg-slate-700 text-slate-600 dark:text-slate-300';
            
            if (diffDays < 0) {
              statusText = 'Completed';
              statusClass = 'bg-slate-100 text-slate-400 dark:bg-slate-700/50 dark:text-slate-500';
              cardBorderClass = 'border-slate-100 dark:border-slate-700/40 opacity-65';
            } else if (diffDays === 0) {
              statusText = 'TODAY';
              statusClass = 'bg-rose-500/10 text-rose-600 dark:bg-rose-500/20 dark:text-rose-400 border border-rose-500/20 font-extrabold';
              calendarHeaderClass = 'bg-rose-600 text-white';
            } else {
              statusText = `${diffDays} Days`;
              statusClass = 'bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-400 border border-indigo-100/30';
              calendarHeaderClass = 'bg-indigo-600 dark:bg-indigo-500 text-white';
            }
        %>
          <div class="flex items-center justify-between gap-4 p-3.5 border rounded-2xl transition-all duration-300 group <%= cardBorderClass %> w-full">
            <!-- Calendar tear-away date block (pure typography, zero SVG) -->
            <div class="flex-shrink-0 flex flex-col items-center justify-center w-12 h-12 rounded-xl overflow-hidden shadow-xs border font-mono-code <%= calendarBgClass %>">
              <span class="text-[8px] font-black uppercase tracking-wider w-full text-center py-1 leading-none <%= calendarHeaderClass %>"><%= monthShort %></span>
              <span class="text-base font-black text-slate-800 dark:text-slate-100 leading-none mt-1"><%= dayNum %></span>
            </div>
            
            <div class="flex-1 min-w-0">
              <h3 class="font-extrabold text-sm leading-snug truncate <%= diffDays < 0 ? 'text-slate-400 dark:text-slate-500 line-through' : 'text-slate-800 dark:text-slate-200 group-hover:text-indigo-600 dark:group-hover:text-indigo-400' %> transition-colors">
                <%= exam.subjectName %>
              </h3>
              <span class="text-[11px] font-mono-code text-slate-400 dark:text-slate-500 block mt-0.5">
                Term <%= exam.term || '3-2' %> &bull; <%= examDate.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit' }) %>
              </span>
            </div>
            
            <span class="flex-shrink-0 text-[9px] font-black font-mono-code px-2.5 py-1 rounded-full tracking-wider uppercase <%= statusClass %> select-none">
              <%= statusText %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

</div>

<!-- 3. STATS GRID -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
  <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm border-t-4 border-t-indigo-500">
    <div class="text-slate-400 dark:text-slate-500 text-xs font-extrabold uppercase tracking-wider mb-2">Total Courses (<%= currentTermId %>)</div>
    <div class="text-3xl font-extrabold font-mono-code text-slate-900 dark:text-white"><%= stats.totalCourses %></div>
  </div>
  
  <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm border-t-4 border-t-violet-500">
    <div class="text-slate-400 dark:text-slate-500 text-xs font-extrabold uppercase tracking-wider mb-2">Total Topics</div>
    <div class="text-3xl font-extrabold font-mono-code text-slate-900 dark:text-white"><%= stats.totalTopics %></div>
  </div>

  <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm border-t-4 border-t-fuchsia-500">
    <div class="text-slate-400 dark:text-slate-500 text-xs font-extrabold uppercase tracking-wider mb-2">Total Questions</div>
    <div class="text-3xl font-extrabold font-mono-code text-slate-900 dark:text-white"><%= stats.totalQuestions %></div>
  </div>

  <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm border-t-4 border-t-emerald-500 flex flex-col justify-between">
    <div>
      <div class="text-slate-400 dark:text-slate-500 text-xs font-extrabold uppercase tracking-wider mb-2">Study Progress</div>
      <div class="text-3xl font-extrabold font-mono-code text-indigo-600 dark:text-indigo-400"><%= stats.overallPercentage %>%</div>
    </div>
    <div class="w-full bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden mt-4">
      <div class="bg-gradient-to-r from-indigo-600 to-emerald-500 dark:from-indigo-400 dark:to-emerald-400 h-full rounded-full transition-all duration-300 progress-bar-fill" style="width: <%= stats.overallPercentage %>%"></div>
    </div>
  </div>
</div>

<!-- 4. COURSES SECTION -->
<div class="mb-12">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-3">
        <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white font-display">
          <%= currentTermId === 'all' ? 'All Semester Courses' : `${currentTermObj.name} Courses` %>
        </h2>
        <span class="px-3 py-0.5 text-xs font-mono-code font-bold rounded-full bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-slate-700">
          <%= courses.length %> <%= courses.length === 1 ? 'Course' : 'Courses' %>
        </span>
      </div>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1">
        <%= currentTermObj.bnTitle %> &bull; <%= currentTermObj.codeSeries %>
      </p>
    </div>

    <div class="flex items-center gap-2">
      <% if (currentTermId !== '4-1') { %>
        <a href="/?term=4-1" class="px-3.5 py-2 rounded-xl text-xs font-extrabold bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/25 hover:bg-amber-500/20 transition-all">
          Switch to Term 4-1 (Current)
        </a>
      <% } %>
      <% if (currentTermId !== '3-2') { %>
        <a href="/?term=3-2" class="px-3.5 py-2 rounded-xl text-xs font-extrabold bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-slate-700 hover:bg-indigo-100 transition-all">
          View Term 3-2 Archive (5)
        </a>
      <% } %>
    </div>
  </div>
  
  <% if (courses.length === 0) { %>
    <div class="bg-white dark:bg-slate-800 rounded-3xl p-8 sm:p-12 text-center border border-slate-200 dark:border-slate-700 shadow-sm relative overflow-hidden">
      <div class="max-w-xl mx-auto">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-mono-code font-black bg-amber-500/15 text-amber-700 dark:text-amber-300 border border-amber-500/30 uppercase tracking-wider mb-3">
          Term <%= currentTermId %> &bull; <%= currentTermObj.codeSeries %>
        </span>
        <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white font-display">
          <% if (currentTermId === '4-1') { %>
            Term 4-1 (৪র্থ বর্ষ ১ম টার্ম) Workspace Ready
          <% } else { %>
            No Courses Added to <%= currentTermObj.name %> Yet
          <% } %>
        </h3>
        <p class="text-slate-500 dark:text-slate-400 text-sm mt-2 leading-relaxed">
          <% if (currentTermId === '4-1') { %>
            এইবারের নতুন <strong>4-1 Term (4100 Series)</strong>-এর কোর্স, লেকচার নোট, স্লাইড এবং প্রশ্নোত্তর যোগ করার সাথে সাথেই এখানে কার্ড আকারে চলে আসবে। আগের <strong>3-2 Term</strong>-এর সব কোর্স দেখতে নিচের বাটনে ক্লিক করো।
          <% } else { %>
            <strong><%= currentTermObj.fullTitle %> (<%= currentTermObj.bnTitle %>)</strong>-এ এখনো কোনো কোর্স যুক্ত করা হয়নি।
          <% } %>
        </p>
        <div class="mt-7 flex flex-wrap items-center justify-center gap-3">
          <a href="/?term=3-2" class="px-6 py-3 rounded-xl text-xs sm:text-sm font-extrabold bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-700 hover:to-violet-700 text-white shadow-md shadow-indigo-500/20 transition-all">
            Open Term 3-2 Archive (5 Courses &bull; 454 Q&amp;As) &rarr;
          </a>
          <button type="button" onclick="openTermModal()" class="px-5 py-3 rounded-xl text-xs sm:text-sm font-bold bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 transition-all cursor-pointer">
            Select Another Term (1-1 to 4-2)
          </button>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% courses.forEach(course => { %>
        <a href="/courses/<%= course.id %>" class="group bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:border-indigo-300 dark:hover:border-indigo-500/60 hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <div class="flex items-center gap-2">
                <span class="px-2.5 py-1 rounded-lg text-xs font-mono-code font-bold bg-indigo-50 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-300 border border-indigo-100 dark:border-indigo-900">
                  <%= course.code %>
                </span>
                <span class="px-2.5 py-1 rounded-lg text-[11px] font-mono-code font-semibold bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-300">
                  Term <%= course.term || '3-2' %>
                </span>
              </div>
              <span class="text-xs font-mono-code font-bold text-indigo-600 dark:text-indigo-400">
                <%= course.percentage %>%
              </span>
            </div>

            <h3 class="text-xl font-extrabold text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors font-display">
              <%= course.name %>
            </h3>
            
            <% if (course.sections && course.sections.length > 0) { %>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-2 font-medium">
                Instructors: <%= course.sections.map(s => s.teacherName).filter(t => t).join(' • ') %>
              </p>
            <% } %>

            <div class="flex items-center gap-3 mt-5 text-xs font-bold text-slate-600 dark:text-slate-300">
              <span class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200/70 dark:border-slate-700">
                <%= course.topicsCount %> Topics
              </span>
              <span class="px-2.5 py-1 rounded-lg bg-slate-50 dark:bg-slate-900 border border-slate-200/70 dark:border-slate-700">
                <%= course.questionsCount %> Questions
              </span>
            </div>
          </div>

          <div class="mt-6 border-t border-slate-100 dark:border-slate-700 pt-4">
            <div class="flex justify-between items-center text-[11px] font-bold text-slate-400 dark:text-slate-500 mb-1.5">
              <span>PROGRESS (<%= course.solvedQuestionsCount %>/<%= course.questionsCount %>)</span>
              <span class="text-indigo-600 dark:text-indigo-400">Open Course &rarr;</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-700 h-1.5 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-indigo-600 to-violet-500 dark:from-indigo-400 dark:to-violet-400 h-full rounded-full transition-all duration-300" style="width: <%= course.percentage %>%"></div>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- 5. 4-YEAR ACADEMIC ROADMAP (1-1 TO 4-2) -->
<div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-3xl p-6 sm:p-8 shadow-sm">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
    <div>
      <span class="text-[11px] font-black uppercase tracking-widest text-indigo-600 dark:text-indigo-400">4-Year B.Sc. Agriculture Curriculum</span>
      <h2 class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-0.5 font-display">
        All Semesters (Term 1-1 to 4-2)
      </h2>
    </div>
    <button type="button" onclick="openTermModal()" class="self-start sm:self-auto px-4 py-2 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 dark:bg-slate-700 dark:hover:bg-slate-600 text-indigo-600 dark:text-indigo-300 transition-colors cursor-pointer">
      Open Term Portal
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <% [1, 2, 3, 4].forEach(yearNum => { 
         const yearTerms = allTermsList.filter(t => t.year === yearNum);
         const yearLabels = { 1: '1st Year (১ম বর্ষ)', 2: '2nd Year (২য় বর্ষ)', 3: '3rd Year (৩য় বর্ষ)', 4: '4th Year (৪র্থ বর্ষ)' };
    %>
      <div class="rounded-2xl p-4 bg-slate-50 dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-700/80 flex flex-col gap-3">
        <div class="flex items-center justify-between border-b border-slate-200/70 dark:border-slate-700 pb-2.5">
          <span class="text-xs font-extrabold uppercase tracking-wider text-slate-700 dark:text-slate-200"><%= yearLabels[yearNum] %></span>
          <span class="text-[10px] font-mono-code font-bold px-2 py-0.5 rounded bg-white dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 border border-slate-200 dark:border-slate-700">Level <%= yearNum %></span>
        </div>

        <div class="space-y-2.5">
          <% yearTerms.forEach(t => { 
               const isSelected = currentTermId === t.id;
               const isCurrent41 = t.id === '4-1';
               const isPrev32 = t.id === '3-2';
          %>
            <a href="/?term=<%= t.id %>" class="block p-3.5 rounded-xl border transition-all duration-200 <%= isSelected ? 'bg-gradient-to-r from-indigo-600 to-violet-600 text-white border-indigo-600 shadow-md' : 'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700 hover:border-indigo-400 dark:hover:border-indigo-500' %>">
              <div class="flex items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                  <span class="text-base font-extrabold font-mono-code <%= isSelected ? 'text-white' : isCurrent41 ? 'text-amber-600 dark:text-amber-400' : isPrev32 ? 'text-indigo-600 dark:text-indigo-400' : 'text-slate-900 dark:text-white' %>">
                    Term <%= t.id %>
                  </span>
                  <% if (isCurrent41) { %>
                    <span class="text-[9px] font-black px-2 py-0.5 rounded-full <%= isSelected ? 'bg-amber-400 text-slate-950' : 'bg-amber-500/20 text-amber-700 dark:text-amber-300' %> uppercase">Current</span>
                  <% } else if (isPrev32) { %>
                    <span class="text-[9px] font-black px-2 py-0.5 rounded-full <%= isSelected ? 'bg-white/20 text-white' : 'bg-indigo-500/15 text-indigo-600 dark:text-indigo-400' %> uppercase">Archive</span>
                  <% } %>
                </div>
                <span class="text-xs font-bold <%= isSelected ? 'text-indigo-100' : 'text-slate-400' %>">&rarr;</span>
              </div>
              <div class="mt-1.5 flex items-center justify-between text-[11px] font-semibold <%= isSelected ? 'text-indigo-100' : 'text-slate-500 dark:text-slate-400' %>">
                <span class="font-mono-code"><%= t.codeSeries %></span>
                <span><%= t.coursesCount %> Courses &bull; <%= t.questionsCount %> Qs</span>
              </div>
            </a>
          <% }) %>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
