<%- include('partials/header') %>

<%
  const currentTermId = locals.activeTerm || '4-1';
  const currentTermObj = locals.activeTermObj || { id: '4-1', name: 'Term 4-1', fullTitle: 'Year 4 • Term 1', bnTitle: '৪র্থ বর্ষ ১ম টার্ম', codeSeries: '4100 Series', status: 'current' };
  const allTermsList = locals.termsOverview || [];
  const term32Summary = allTermsList.find(t => t.id === '3-2') || { coursesCount: 5, questionsCount: 454, topicsCount: 18 };
%>

<!-- Minimal Term Switcher Bar (1-1 to 4-2) -->
<div class="mb-8 pb-4 border-b border-slate-200 dark:border-slate-800/90 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
  <div class="text-xs font-mono-code uppercase tracking-wider text-slate-400 dark:text-slate-500">
    Semesters
  </div>

  <div class="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0">
    <% allTermsList.forEach(t => { 
         const isActive = currentTermId === t.id;
    %>
      <a href="/?term=<%= t.id %>" class="px-3 py-1 rounded text-xs font-mono-code font-medium transition-colors border <%= isActive ? 'bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white' : 'bg-white dark:bg-[#111217] text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600' %>">
        <%= t.id %><% if (t.id === '4-1') { %> (Now)<% } else if (t.coursesCount > 0) { %> (<%= t.coursesCount %>)<% } %>
      </a>
    <% }) %>
    <a href="/?term=all" class="px-3 py-1 rounded text-xs font-mono-code font-medium transition-colors border <%= currentTermId === 'all' ? 'bg-slate-900 text-white border-slate-900 dark:bg-white dark:text-slate-900 dark:border-white' : 'bg-white dark:bg-[#111217] text-slate-600 dark:text-slate-400 border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600' %>">
      All
    </a>
  </div>
</div>

<!-- Mobile Search Input -->
<div class="block md:hidden mb-6 relative">
  <form action="/search" method="GET">
    <input type="text" name="q" id="mobile-search-input" autocomplete="off" placeholder="Search courses, topics, or questions..." 
      class="block w-full px-3.5 py-2 border border-slate-200 dark:border-slate-800 rounded-md bg-white dark:bg-[#111217] focus:outline-none focus:border-slate-400 text-xs">
  </form>
  <div id="mobile-search-results-dropdown" class="absolute left-0 right-0 mt-1 w-full bg-white dark:bg-[#121318] rounded-md shadow-lg border border-slate-200 dark:border-slate-800 max-h-80 overflow-y-auto hidden z-50"></div>
</div>

<!-- Semester Header & Summary Metrics -->
<div class="mb-10 bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6">
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-6 pb-6 border-b border-slate-100 dark:border-slate-800/80">
    <div>
      <div class="flex items-center gap-2 text-xs font-mono-code text-slate-500 dark:text-slate-400">
        <span><%= currentTermObj.codeSeries %></span>
        <span>&bull;</span>
        <span><%= currentTermId === '4-1' ? 'Current Active Term' : currentTermId === '3-2' ? 'Previous Term Archive' : currentTermObj.fullTitle %></span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white mt-1.5 tracking-tight">
        <%= currentTermObj.name %> &mdash; <span class="font-normal text-slate-600 dark:text-slate-300"><%= currentTermObj.bnTitle %></span>
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-2 max-w-2xl leading-relaxed">
        <% if (currentTermId === '4-1') { %>
          ৪র্থ বর্ষ ১ম সেমিস্টার (4-1) চলমান টার্ম। আগের 3-2 টার্মের ৫টি কোর্স ও ৪৫৪টি প্রশ্নোত্তর আর্কাইভে সংরক্ষিত রয়েছে।
        <% } else if (currentTermId === '3-2') { %>
          ৩য় বর্ষ ২য় সেমিস্টার (3-2) আর্কাইভ &mdash; ৫টি কোর্সের লেকচার নোট, টপিক ও ৪৫৪টি প্রশ্নোত্তর।
        <% } else { %>
          <%= currentTermObj.fullTitle %> (<%= currentTermObj.bnTitle %>) কোর্স ও নোটস আর্কাইভ।
        <% } %>
      </p>
    </div>

    <div class="flex items-center gap-2 flex-shrink-0">
      <button type="button" onclick="openTermModal()" class="px-3.5 py-2 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-800 dark:text-slate-200 hover:border-slate-400 dark:hover:border-slate-600 transition-colors cursor-pointer">
        Change Term
      </button>
      <% if (currentTermId !== '3-2') { %>
        <a href="/?term=3-2" class="px-3.5 py-2 rounded-md text-xs font-medium bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity">
          Term 3-2 Archive (<%= term32Summary.coursesCount %>)
        </a>
      <% } else { %>
        <a href="/?term=4-1" class="px-3.5 py-2 rounded-md text-xs font-medium bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity">
          Term 4-1 (Current)
        </a>
      <% } %>
    </div>
  </div>

  <!-- Minimalist 4-Column Metrics -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 pt-6">
    <div>
      <div class="text-[11px] font-mono-code uppercase text-slate-400 dark:text-slate-500">Courses</div>
      <div class="text-2xl font-semibold font-mono-code text-slate-900 dark:text-white mt-1"><%= stats.totalCourses %></div>
    </div>
    <div>
      <div class="text-[11px] font-mono-code uppercase text-slate-400 dark:text-slate-500">Topics</div>
      <div class="text-2xl font-semibold font-mono-code text-slate-900 dark:text-white mt-1"><%= stats.totalTopics %></div>
    </div>
    <div>
      <div class="text-[11px] font-mono-code uppercase text-slate-400 dark:text-slate-500">Questions</div>
      <div class="text-2xl font-semibold font-mono-code text-slate-900 dark:text-white mt-1"><%= stats.totalQuestions %></div>
    </div>
    <div>
      <div class="flex items-center justify-between text-[11px] font-mono-code uppercase text-slate-400 dark:text-slate-500">
        <span>Progress</span>
        <span><%= stats.overallPercentage %>%</span>
      </div>
      <div class="text-2xl font-semibold font-mono-code text-slate-900 dark:text-white mt-1">
        <%= stats.solvedQuestions %><span class="text-sm font-normal text-slate-400">/<%= stats.totalQuestions %></span>
      </div>
      <div class="w-full bg-slate-100 dark:bg-slate-800 h-1 rounded-full overflow-hidden mt-2">
        <div class="bg-slate-900 dark:bg-white h-full transition-all duration-300" style="width: <%= stats.overallPercentage %>%"></div>
      </div>
    </div>
  </div>
</div>

<!-- Quote & Exam Schedule Row (Clean Editorial Style) -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-10">
  <!-- Daily Quote -->
  <div class="lg:col-span-2 bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6 flex flex-col justify-between">
    <% if (locals.quote) { %>
      <div>
        <div class="text-[11px] font-mono-code uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-3">
          Daily Reminder
        </div>
        <blockquote class="text-base sm:text-lg font-medium text-slate-800 dark:text-slate-200 leading-relaxed border-l-2 border-slate-900 dark:border-slate-400 pl-4">
          "<%= quote.text %>"
        </blockquote>
      </div>
      <div class="text-xs text-slate-500 dark:text-slate-400 mt-4 font-medium">
        &mdash; <%= quote.source %>
      </div>
    <% } %>
  </div>

  <!-- Exam Schedule List -->
  <div class="bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-100 dark:border-slate-800">
      <h2 class="text-xs font-mono-code uppercase tracking-wider text-slate-500 dark:text-slate-400">
        Exam Schedule (<%= currentTermId === 'all' ? 'All' : currentTermId %>)
      </h2>
      <span class="text-[11px] font-mono-code text-slate-400"><%= exams ? exams.length : 0 %> items</span>
    </div>

    <% if (!exams || exams.length === 0) { %>
      <div class="py-6 text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
        No exams scheduled for Term <span class="font-mono-code font-medium"><%= currentTermId %></span> yet.
      </div>
    <% } else { %>
      <div class="divide-y divide-slate-100 dark:divide-slate-800/70">
        <% 
          const now = new Date();
          exams.forEach((exam) => {
            const examDate = new Date(exam.examDate);
            const examDateDay = new Date(examDate.getFullYear(), examDate.getMonth(), examDate.getDate());
            const todayDay = new Date(now.getFullYear(), now.getMonth(), now.getDate());
            const diffDays = Math.round((examDateDay - todayDay) / (1000 * 60 * 60 * 24));
        %>
          <div class="py-2.5 first:pt-0 last:pb-0 flex items-center justify-between gap-3 text-xs">
            <div class="min-w-0">
              <div class="font-medium truncate <%= diffDays < 0 ? 'text-slate-400 dark:text-slate-500 line-through' : 'text-slate-800 dark:text-slate-200' %>">
                <%= exam.subjectName %>
              </div>
              <div class="text-[11px] font-mono-code text-slate-400 dark:text-slate-500 mt-0.5">
                <%= examDate.toLocaleDateString(undefined, { day: '2-digit', month: 'short', year: 'numeric' }) %>
              </div>
            </div>
            <span class="font-mono-code text-[11px] text-slate-500 dark:text-slate-400 flex-shrink-0">
              <%= diffDays < 0 ? 'Done' : diffDays === 0 ? 'Today' : `${diffDays}d` %>
            </span>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</div>

<!-- Courses List Section -->
<div class="mb-12">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-base font-semibold text-slate-900 dark:text-white">
      <%= currentTermId === 'all' ? 'All Courses' : `Courses — Term ${currentTermId}` %>
    </h2>
    <span class="text-xs font-mono-code text-slate-400 dark:text-slate-500">
      <%= courses.length %> <%= courses.length === 1 ? 'course' : 'courses' %>
    </span>
  </div>
  
  <% if (courses.length === 0) { %>
    <div class="bg-white dark:bg-[#111217] rounded-lg p-8 border border-slate-200 dark:border-slate-800">
      <div class="max-w-lg">
        <div class="text-xs font-mono-code uppercase text-slate-400 dark:text-slate-500">
          Term <%= currentTermId %> &bull; <%= currentTermObj.codeSeries %>
        </div>
        <h3 class="text-lg font-semibold text-slate-900 dark:text-white mt-1">
          <% if (currentTermId === '4-1') { %>
            Term 4-1 Workspace Ready
          <% } else { %>
            No courses added for Term <%= currentTermId %> yet
          <% } %>
        </h3>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1.5 leading-relaxed">
          <% if (currentTermId === '4-1') { %>
            এইবারের চলমান 4-1 টার্মের (4100 Series) কোর্স, লেকচার নোট এবং প্রশ্নোত্তর যোগ করার সাথে সাথেই এখানে তালিকাভুক্ত হবে। আগের 3-2 টার্মের কোর্সগুলো দেখতে নিচের বাটনে ক্লিক করো।
          <% } else { %>
            এই সেমিস্টারে এখনো কোনো কোর্স যুক্ত করা হয়নি।
          <% } %>
        </p>
        <div class="mt-5 flex items-center gap-3">
          <a href="/?term=3-2" class="px-4 py-2 rounded-md text-xs font-medium bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity">
            Open Term 3-2 Archive (5 Courses)
          </a>
          <button type="button" onclick="openTermModal()" class="px-4 py-2 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-400 transition-colors cursor-pointer">
            Select Another Term
          </button>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
      <% courses.forEach(course => { %>
        <a href="/courses/<%= course.id %>" class="group bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-5 hover:border-slate-400 dark:hover:border-slate-600 transition-colors flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 text-xs font-mono-code text-slate-500 dark:text-slate-400 mb-2">
              <span><%= course.code %></span>
              <span>Term <%= course.term || '3-2' %></span>
            </div>

            <h3 class="text-base font-semibold text-slate-900 dark:text-white group-hover:underline leading-snug">
              <%= course.name %>
            </h3>
            
            <% if (course.sections && course.sections.length > 0) { %>
              <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5 truncate">
                <%= course.sections.map(s => s.teacherName).filter(t => t).join(', ') || 'Section A & B' %>
              </p>
            <% } %>

            <div class="flex items-center gap-4 mt-4 text-xs font-mono-code text-slate-500 dark:text-slate-400">
              <span><%= course.topicsCount %> topics</span>
              <span>&bull;</span>
              <span><%= course.questionsCount %> questions</span>
            </div>
          </div>

          <div class="mt-5 pt-3.5 border-t border-slate-100 dark:border-slate-800/80">
            <div class="flex justify-between items-center text-[11px] font-mono-code text-slate-400 dark:text-slate-500 mb-1.5">
              <span><%= course.solvedQuestionsCount %>/<%= course.questionsCount %> solved</span>
              <span><%= course.percentage %>%</span>
            </div>
            <div class="w-full bg-slate-100 dark:bg-slate-800 h-1 rounded-full overflow-hidden">
              <div class="bg-slate-900 dark:bg-white h-full transition-all duration-300" style="width: <%= course.percentage %>%"></div>
            </div>
          </div>
        </a>
      <% }) %>
    </div>
  <% } %>
</div>

<!-- Minimalist 8-Semester Index Table / Grid (1-1 to 4-2) -->
<div class="border-t border-slate-200 dark:border-slate-800/80 pt-8">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-xs font-mono-code uppercase tracking-wider text-slate-500 dark:text-slate-400">
      Academic Index (Terms 1-1 to 4-2)
    </h2>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-2.5">
    <% allTermsList.forEach(t => { 
         const isSelected = currentTermId === t.id;
    %>
      <a href="/?term=<%= t.id %>" class="p-3 rounded-md border transition-colors <%= isSelected ? 'border-slate-900 dark:border-white bg-white dark:bg-[#111217]' : 'border-slate-200 dark:border-slate-800/80 bg-white/60 dark:bg-[#111217]/60 hover:border-slate-400 dark:hover:border-slate-600' %>">
        <div class="flex items-center justify-between">
          <span class="font-mono-code text-xs font-semibold text-slate-900 dark:text-white"><%= t.id %></span>
          <% if (t.id === '4-1') { %>
            <span class="text-[10px] font-mono-code text-slate-500">Now</span>
          <% } %>
        </div>
        <div class="text-[11px] text-slate-400 dark:text-slate-500 mt-1 font-mono-code">
          <%= t.coursesCount %>c / <%= t.questionsCount %>q
        </div>
      </a>
    <% }) %>
  </div>
</div>

<%- include('partials/footer') %>
