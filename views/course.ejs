<%- include('partials/header') %>

<!-- Breadcrumb -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3 text-xs">
  <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
    <a href="/?term=<%= course.term || '3-2' %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
      &larr; Term <%= course.term || '3-2' %>
    </a>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-medium"><%= course.code %></span>
  </div>
  <span class="font-mono-code text-slate-400 dark:text-slate-500">
    Term <%= course.term || '3-2' %>
  </span>
</div>

<!-- Course Header -->
<div class="mb-8 bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 p-6 rounded-lg flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
  <div>
    <div class="text-xs font-mono-code text-slate-400 dark:text-slate-500">
      Course <%= course.code %> &bull; Term <%= course.term || '3-2' %>
    </div>
    <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white mt-1 tracking-tight">
      <%= course.name %>
    </h1>
  </div>
  <div class="flex flex-wrap gap-2.5">
    <a href="/downloads/course_<%= course.id %>_questions.docx" class="px-3.5 py-2 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-slate-400 dark:hover:border-slate-600 transition-colors" download>
      Previous Questions (.docx)
    </a>
    <a href="/downloads/course_<%= course.id %>_solve.docx" class="px-3.5 py-2 rounded-md text-xs font-medium bg-slate-900 text-white dark:bg-white dark:text-slate-900 hover:opacity-90 transition-opacity" download>
      Solved Archive (.docx)
    </a>
  </div>
</div>

<!-- Sections List -->
<div class="space-y-6">
  <% if (course.Sections && course.Sections.length > 0) { %>
    <% course.Sections.forEach(section => { %>
      <div class="bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 pb-5 border-b border-slate-100 dark:border-slate-800">
          <div>
            <div class="flex items-center gap-3 flex-wrap">
              <h2 class="text-lg font-semibold text-slate-900 dark:text-white"><%= section.name %></h2>
              <button onclick="openAnalysisModal('<%= section.id %>', '<%= section.name %>')" class="text-xs font-medium px-2.5 py-1 rounded border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-300 hover:border-slate-400 dark:hover:border-slate-600 transition-colors cursor-pointer">
                Syllabus &amp; Exam Pattern
              </button>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
              Instructor: <%= section.teacherName || 'Not Specified' %>
            </p>
          </div>
          
          <div class="flex items-center gap-4">
            <div class="text-xs font-mono-code text-slate-500 dark:text-slate-400">
              <%= section.solvedCount %>/<%= section.totalCount %> solved (<%= section.percentage %>%)
            </div>
            <div class="w-24 bg-slate-100 dark:bg-slate-800 h-1 rounded-full overflow-hidden">
              <div class="bg-slate-900 dark:bg-white h-full" style="width: <%= section.percentage %>%"></div>
            </div>
          </div>
        </div>

        <!-- Section Links -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-5">
          <a href="/courses/<%= course.id %>/notes?sectionId=<%= section.id %>" class="p-4 rounded-md border border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 transition-colors flex items-center justify-between">
            <div>
              <span class="block font-medium text-sm text-slate-900 dark:text-white">Course Notes &amp; Lectures</span>
              <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">Structured lecture material, tables, and figures</span>
            </div>
            <span class="text-xs text-slate-400">&rarr;</span>
          </a>

          <a href="/courses/<%= course.id %>/qa?sec=<%= section.id %>" class="p-4 rounded-md border border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600 transition-colors flex items-center justify-between">
            <div>
              <span class="block font-medium text-sm text-slate-900 dark:text-white">Questions &amp; Answers (<%= section.totalCount %>)</span>
              <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">Topic-wise questions with verified answers</span>
            </div>
            <span class="text-xs text-slate-400">&rarr;</span>
          </a>
        </div>

        <!-- PDF Footer -->
        <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
          <span>Section Reference PDF</span>
          <div class="flex gap-4 font-medium">
            <a href="/courses/<%= course.id %>/pdf/<%= section.id %>/view" target="_blank" class="hover:text-slate-900 dark:hover:text-white transition-colors">
              View PDF
            </a>
            <a href="/courses/<%= course.id %>/pdf/<%= section.id %>/download" class="hover:text-slate-900 dark:hover:text-white transition-colors">
              Download PDF
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="bg-white dark:bg-[#111217] rounded-lg p-10 text-center border border-slate-200 dark:border-slate-800">
      <h3 class="text-sm font-semibold text-slate-800 dark:text-white">No sections available</h3>
    </div>
  <% } %>
</div>

<!-- Minimalist Analysis Modal -->
<div id="analysis-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-[2px] transition-opacity duration-200 opacity-0 hidden" role="dialog" aria-modal="true">
  <div class="fixed inset-0" onclick="closeAnalysisModal()"></div>
  
  <div class="relative bg-white dark:bg-[#111217] rounded-lg max-w-2xl w-full max-h-[85vh] shadow-xl border border-slate-200 dark:border-slate-800 modal-content-panel transform scale-95 opacity-0 transition-all duration-200 flex flex-col overflow-hidden z-10">
    <div class="border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex items-center justify-between">
      <div>
        <h3 class="text-base font-semibold text-slate-900 dark:text-white">
          Question Analysis &mdash; <span id="modal-section-title">Section</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Instructor: <span id="modal-teacher-name"></span></p>
      </div>
      <button onclick="closeAnalysisModal()" class="text-xs font-mono-code text-slate-400 hover:text-slate-700 dark:hover:text-white px-2 py-1 cursor-pointer">
        ESC
      </button>
    </div>

    <div class="flex border-b border-slate-200 dark:border-slate-800 px-6">
      <button onclick="switchTab('overview')" id="tab-btn-overview" class="py-2.5 px-3 text-xs font-medium border-b-2 border-slate-900 dark:border-white text-slate-900 dark:text-white cursor-pointer">
        Overview
      </button>
      <button onclick="switchTab('topics')" id="tab-btn-topics" class="py-2.5 px-3 text-xs font-medium text-slate-500 dark:text-slate-400 border-b-2 border-transparent cursor-pointer">
        Key Topics
      </button>
      <button onclick="switchTab('action')" id="tab-btn-action" class="py-2.5 px-3 text-xs font-medium text-slate-500 dark:text-slate-400 border-b-2 border-transparent cursor-pointer">
        Preparation Notes
      </button>
    </div>
    
    <div class="p-6 overflow-y-auto flex-1 space-y-4">
      <div id="tab-content-overview" class="space-y-4">
        <div class="p-4 rounded-md border border-slate-200 dark:border-slate-800">
          <div class="text-[11px] font-mono-code uppercase text-slate-400 mb-1" id="modal-style-badge"></div>
          <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed" id="modal-desc"></p>
        </div>
        <div class="p-4 rounded-md border border-slate-200 dark:border-slate-800">
          <h4 class="font-semibold text-xs uppercase tracking-wider text-slate-500 mb-1.5">Exam Format</h4>
          <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed" id="modal-structure"></p>
        </div>
        <div class="p-4 rounded-md border border-slate-200 dark:border-slate-800">
          <h4 class="font-semibold text-xs uppercase tracking-wider text-slate-500 mb-1.5">Evaluation Focus</h4>
          <p class="text-xs text-slate-700 dark:text-slate-300 leading-relaxed" id="modal-persona"></p>
        </div>
      </div>

      <div id="tab-content-topics" class="space-y-3 hidden">
        <div class="space-y-3" id="modal-topics-list"></div>
      </div>

      <div id="tab-content-action" class="space-y-4 hidden">
        <div class="p-4 rounded-md border border-slate-200 dark:border-slate-800">
          <h4 class="font-semibold text-xs uppercase tracking-wider text-slate-500 mb-2.5">Recurrent Patterns</h4>
          <ul class="space-y-2 list-disc pl-4 text-xs text-slate-700 dark:text-slate-300" id="modal-trends-list"></ul>
        </div>
        <div class="p-4 rounded-md border border-slate-200 dark:border-slate-800">
          <h4 class="font-semibold text-xs uppercase tracking-wider text-slate-500 mb-2.5">Study Checklist</h4>
          <ul class="space-y-2 list-disc pl-4 text-xs text-slate-700 dark:text-slate-300" id="modal-tips-list"></ul>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-200 dark:border-slate-800 px-6 py-3.5 flex justify-end">
      <button onclick="closeAnalysisModal()" class="px-4 py-1.5 rounded text-xs font-medium bg-slate-900 text-white dark:bg-white dark:text-slate-900 cursor-pointer">
        Close
      </button>
    </div>
  </div>
</div>

<script>
  const sectionsAnalysis = <%- JSON.stringify(course.Sections.reduce((acc, sec) => { acc[sec.id] = sec.analysis; return acc; }, {})) %>;
  
  function switchTab(tabId) {
    ['overview', 'topics', 'action'].forEach(t => {
      document.getElementById(`tab-content-${t}`).classList.add('hidden');
      document.getElementById(`tab-btn-${t}`).className = "py-2.5 px-3 text-xs font-medium text-slate-500 dark:text-slate-400 border-b-2 border-transparent cursor-pointer";
    });
    document.getElementById(`tab-content-${tabId}`).classList.remove('hidden');
    document.getElementById(`tab-btn-${tabId}`).className = "py-2.5 px-3 text-xs font-medium border-b-2 border-slate-900 dark:border-white text-slate-900 dark:text-white cursor-pointer";
  }
  
  function openAnalysisModal(sectionId, sectionName) {
    const analysis = sectionsAnalysis[sectionId];
    if (!analysis) return;
    
    document.getElementById('modal-section-title').textContent = sectionName;
    document.getElementById('modal-teacher-name').textContent = analysis.teacher || 'Instructor';
    document.getElementById('modal-style-badge').textContent = analysis.style || '';
    document.getElementById('modal-desc').textContent = analysis.desc || '';
    document.getElementById('modal-structure').textContent = analysis.examStructure || '';
    document.getElementById('modal-persona').textContent = analysis.teacherPersona || '';
    
    const topicsContainer = document.getElementById('modal-topics-list');
    topicsContainer.innerHTML = '';
    analysis.importantTopics.forEach(topic => {
      const topicEl = document.createElement('div');
      topicEl.className = 'border border-slate-200 dark:border-slate-800 p-4 rounded-md';
      topicEl.innerHTML = `
        <div class="flex items-center justify-between gap-2">
          <h4 class="font-semibold text-xs sm:text-sm text-slate-900 dark:text-white">${topic.name}</h4>
          <span class="text-[10px] font-mono-code px-2 py-0.5 rounded border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300">${topic.weight}</span>
        </div>
        <p class="mt-2 text-xs text-slate-600 dark:text-slate-300 leading-relaxed"><strong>Questions:</strong> ${topic.typicalQuestions}</p>
        <p class="mt-1.5 text-xs text-slate-500 dark:text-slate-400 leading-relaxed"><strong>Note:</strong> ${topic.scoringTips}</p>
      `;
      topicsContainer.appendChild(topicEl);
    });
    
    const trendsContainer = document.getElementById('modal-trends-list');
    trendsContainer.innerHTML = '';
    analysis.chronologicalTrends.forEach(trend => {
      const li = document.createElement('li');
      li.textContent = trend;
      trendsContainer.appendChild(li);
    });
    
    const tipsContainer = document.getElementById('modal-tips-list');
    tipsContainer.innerHTML = '';
    analysis.prepTips.forEach(tip => {
      const li = document.createElement('li');
      li.textContent = tip;
      tipsContainer.appendChild(li);
    });
    
    switchTab('overview');
    const modal = document.getElementById('analysis-modal');
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modal.querySelector('.modal-content-panel').classList.remove('scale-95', 'opacity-0');
    }, 10);
  }
  
  function closeAnalysisModal() {
    const modal = document.getElementById('analysis-modal');
    modal.classList.add('opacity-0');
    modal.querySelector('.modal-content-panel').classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 200);
  }
</script>

<%- include('partials/footer') %>
