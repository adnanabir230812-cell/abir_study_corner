<%- include('partials/header') %>

<!-- Back Link & Breadcrumbs -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3">
  <a href="/?term=<%= course.term || '3-2' %>" class="inline-flex items-center gap-1.5 text-sm font-bold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 transition-colors">
    <span>&larr;</span>
    <span>Back to Term <%= course.term || '3-2' %> Dashboard</span>
  </a>
  <span class="text-xs font-mono-code font-bold px-3 py-1 rounded-full bg-indigo-50 dark:bg-slate-800 text-indigo-600 dark:text-indigo-400 border border-indigo-100 dark:border-slate-700">
    Academic Term <%= course.term || '3-2' %>
  </span>
</div>

<!-- Course Title Banner -->
<div class="mb-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 p-6 sm:p-8 rounded-2xl shadow-sm">
  <div>
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-xs font-bold text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-slate-900/60 px-3 py-1 rounded-full uppercase tracking-wider border border-indigo-100 dark:border-slate-700">Course Vault</span>
      <span class="text-xs font-mono-code font-bold text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 px-3 py-1 rounded-full">Term <%= course.term || '3-2' %></span>
      <span class="text-xs font-mono-code font-bold text-emerald-700 dark:text-emerald-300 bg-emerald-50 dark:bg-emerald-950/50 px-3 py-1 rounded-full border border-emerald-200/60 dark:border-emerald-800/60">Code: <%= course.code %></span>
    </div>
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white mt-3 tracking-tight font-display"><%= course.name %> (<%= course.code %>)</h1>
  </div>
  <div class="flex flex-wrap gap-3">
    <a href="/downloads/course_<%= course.id %>_questions.docx" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-xs sm:text-sm font-bold py-3 px-5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5" download>
      Previous Year Questions (.docx)
    </a>
    <a href="/downloads/course_<%= course.id %>_solve.docx" class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-700 hover:to-teal-700 text-white text-xs sm:text-sm font-bold py-3 px-5 rounded-xl shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5" download>
      Previous Year Solve (.docx)
    </a>
  </div>
</div>

<!-- Sections List -->
<div class="grid grid-cols-1 gap-8">
  <% if (course.Sections && course.Sections.length > 0) { %>
    <% course.Sections.forEach(section => { %>
      <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-md transition-all">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6 pb-6 border-b border-slate-100 dark:border-slate-700">
          <div>
            <div class="flex items-center gap-3 flex-wrap">
              <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white font-display"><%= section.name %></h2>
              <button onclick="openAnalysisModal('<%= section.id %>', '<%= section.name %>')" class="bg-indigo-50 hover:bg-indigo-100 dark:bg-indigo-950 dark:hover:bg-indigo-900 text-indigo-700 dark:text-indigo-300 text-xs font-extrabold px-3.5 py-1.5 rounded-lg border border-indigo-100 dark:border-indigo-900 transition-all cursor-pointer">
                Question Analysis &amp; Syllabus
              </button>
            </div>
            <p class="text-sm font-medium text-slate-500 dark:text-slate-400 mt-1">Instructor: <span class="text-slate-700 dark:text-slate-200 font-semibold"><%= section.teacherName || 'Not Specified' %></span></p>
          </div>
          
          <div class="flex items-center gap-6 self-start lg:self-center">
            <div class="text-right">
              <span class="text-xs text-slate-400 dark:text-slate-500 font-bold block uppercase mb-1">Section Solved</span>
              <span class="text-sm font-mono-code font-bold text-slate-700 dark:text-slate-200">
                <%= section.solvedCount %>/<%= section.totalCount %> Questions (<%= section.percentage %>%)
              </span>
            </div>
            <div class="w-32 bg-slate-100 dark:bg-slate-700 h-2 rounded-full overflow-hidden">
              <div class="bg-gradient-to-r from-indigo-600 to-violet-500 dark:from-indigo-400 dark:to-violet-400 h-full rounded-full" style="width: <%= section.percentage %>%"></div>
            </div>
          </div>
        </div>

        <!-- Action Options Grid (Rich Colored Cards, Zero SVGs) -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
          <a href="/courses/<%= course.id %>/notes?sectionId=<%= section.id %>" class="flex items-center justify-between gap-5 p-6 rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:bg-indigo-50/50 dark:hover:bg-slate-800/80 hover:border-indigo-300 dark:hover:border-indigo-500/60 transition-all group shadow-xs">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-indigo-100 dark:bg-indigo-950/80 text-indigo-600 dark:text-indigo-400 font-mono-code font-black text-sm flex items-center justify-center border border-indigo-200/60 dark:border-indigo-800/60 group-hover:scale-105 transition-transform">
                DOC
              </div>
              <div>
                <span class="block font-extrabold text-lg text-slate-800 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors font-display">Course Content &amp; Notes</span>
                <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">Lecture notes, structured lists, tables and diagrams</span>
              </div>
            </div>
            <span class="text-indigo-600 dark:text-indigo-400 font-bold text-lg group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>

          <a href="/courses/<%= course.id %>/qa?sec=<%= section.id %>" class="flex items-center justify-between gap-5 p-6 rounded-2xl border border-slate-200/80 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 hover:bg-indigo-50/50 dark:hover:bg-slate-800/80 hover:border-indigo-300 dark:hover:border-indigo-500/60 transition-all group shadow-xs">
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-2xl bg-violet-100 dark:bg-violet-950/80 text-violet-600 dark:text-violet-400 font-mono-code font-black text-sm flex items-center justify-center border border-violet-200/60 dark:border-violet-800/60 group-hover:scale-105 transition-transform">
                Q&amp;A
              </div>
              <div>
                <span class="block font-extrabold text-lg text-slate-800 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors font-display">Questions &amp; Answers (<%= section.totalCount %>)</span>
                <span class="block text-xs text-slate-500 dark:text-slate-400 mt-0.5">Topic-wise collapsible Q&amp;As with progress tracking</span>
              </div>
            </div>
            <span class="text-indigo-600 dark:text-indigo-400 font-bold text-lg group-hover:translate-x-1 transition-transform">&rarr;</span>
          </a>
        </div>

        <!-- PDF Section -->
        <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between gap-4 text-xs font-bold text-slate-500 dark:text-slate-400">
          <span>Study Guide PDF Reference</span>
          <div class="flex gap-5">
            <a href="/courses/<%= course.id %>/pdf/<%= section.id %>/view" target="_blank" class="text-indigo-600 dark:text-indigo-400 hover:underline transition-colors">
              View PDF &nearr;
            </a>
            <a href="/courses/<%= course.id %>/pdf/<%= section.id %>/download" class="text-emerald-600 dark:text-emerald-400 hover:underline transition-colors">
              Download PDF &darr;
            </a>
          </div>
        </div>
      </div>
    <% }) %>
  <% } else { %>
    <div class="bg-white dark:bg-slate-800 rounded-2xl p-12 text-center border border-slate-200 dark:border-slate-700">
      <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-1">No sections created</h3>
      <p class="text-slate-500 dark:text-slate-400 max-w-sm mx-auto text-sm">Sections will appear here once added to the course.</p>
    </div>
  <% } %>
</div>

<!-- Question Analysis Modal -->
<div id="analysis-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm transition-opacity duration-250 opacity-0 hidden" role="dialog" aria-modal="true">
  <div class="fixed inset-0 transition-opacity" onclick="closeAnalysisModal()"></div>
  
  <div class="relative bg-white dark:bg-slate-800 rounded-2xl max-w-2xl w-full max-h-[85vh] shadow-2xl border border-slate-200 dark:border-slate-700 modal-content-panel transform scale-95 opacity-0 transition-all duration-250 flex flex-col overflow-hidden z-10">
    <div class="bg-white dark:bg-slate-800 border-b border-slate-100 dark:border-slate-700 px-6 py-4 flex items-center justify-between">
      <div>
        <h3 class="text-xl font-extrabold text-slate-900 dark:text-white font-display">
          Question Analysis: <span id="modal-section-title">Section A</span>
        </h3>
        <p class="text-xs text-slate-500 dark:text-slate-400 mt-0.5">Instructor: <span id="modal-teacher-name" class="font-semibold text-indigo-600 dark:text-indigo-400"></span></p>
      </div>
      <button onclick="closeAnalysisModal()" class="text-xs font-bold text-slate-500 hover:text-slate-800 dark:text-slate-400 dark:hover:text-white px-3 py-1.5 bg-slate-100 dark:bg-slate-700 rounded-lg transition-all cursor-pointer">
        Close
      </button>
    </div>

    <div class="flex border-b border-slate-100 dark:border-slate-700 px-6 bg-slate-50/50 dark:bg-slate-900/30">
      <button onclick="switchTab('overview')" id="tab-btn-overview" class="py-3 px-4 text-xs font-black border-b-2 border-indigo-600 text-indigo-600 dark:text-indigo-400 dark:border-indigo-400 transition-all cursor-pointer uppercase tracking-wider">
        Overview &amp; Persona
      </button>
      <button onclick="switchTab('topics')" id="tab-btn-topics" class="py-3 px-4 text-xs font-bold text-slate-500 dark:text-slate-400 border-b-2 border-transparent transition-all cursor-pointer uppercase tracking-wider">
        High-Yield Topics
      </button>
      <button onclick="switchTab('action')" id="tab-btn-action" class="py-3 px-4 text-xs font-bold text-slate-500 dark:text-slate-400 border-b-2 border-transparent transition-all cursor-pointer uppercase tracking-wider">
        Prep Action Plan
      </button>
    </div>
    
    <div class="p-6 overflow-y-auto flex-1 max-h-[calc(85vh-160px)]">
      <div id="tab-content-overview" class="space-y-5">
        <div class="bg-indigo-50/40 dark:bg-slate-900/50 p-5 rounded-2xl border border-indigo-100 dark:border-slate-700">
          <div class="flex items-center gap-2 mb-2.5">
            <span class="text-[10px] font-black bg-indigo-600 text-white px-2.5 py-0.5 rounded-full uppercase tracking-wider" id="modal-style-badge"></span>
            <span class="text-xs font-bold text-slate-400 dark:text-slate-500">Question Style</span>
          </div>
          <p class="text-sm text-slate-700 dark:text-slate-300 leading-relaxed" id="modal-desc"></p>
        </div>
        
        <div class="bg-slate-50 dark:bg-slate-900/40 p-5 rounded-2xl border border-slate-200/70 dark:border-slate-700">
          <h4 class="font-extrabold text-sm text-slate-900 dark:text-white mb-2">Exam Structure &amp; Format</h4>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-semibold" id="modal-structure"></p>
        </div>

        <div class="bg-slate-50 dark:bg-slate-900/40 p-5 rounded-2xl border border-slate-200/70 dark:border-slate-700">
          <h4 class="font-extrabold text-sm text-slate-900 dark:text-white mb-2">Instructor's Grading Mindset</h4>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed" id="modal-persona"></p>
        </div>
      </div>

      <div id="tab-content-topics" class="space-y-4 hidden">
        <div class="grid grid-cols-1 gap-4" id="modal-topics-list"></div>
      </div>

      <div id="tab-content-action" class="space-y-5 hidden">
        <div class="bg-amber-50/40 dark:bg-amber-950/20 p-5 rounded-2xl border border-amber-200/60 dark:border-amber-900/40">
          <h4 class="font-extrabold text-sm text-slate-900 dark:text-white mb-3">Chronological &amp; Alternate Year Trends</h4>
          <ul class="space-y-2 list-disc pl-4 text-xs text-slate-700 dark:text-slate-300" id="modal-trends-list"></ul>
        </div>

        <div class="bg-emerald-50/40 dark:bg-emerald-950/20 p-5 rounded-2xl border border-emerald-200/60 dark:border-emerald-900/40">
          <h4 class="font-extrabold text-sm text-slate-900 dark:text-white mb-3">Action Plan Checklist</h4>
          <ul class="space-y-2.5 list-disc pl-4 text-xs text-slate-700 dark:text-slate-300" id="modal-tips-list"></ul>
        </div>
      </div>
    </div>

    <div class="border-t border-slate-100 dark:border-slate-700 px-6 py-4 flex justify-end bg-slate-50 dark:bg-slate-900/30">
      <button onclick="closeAnalysisModal()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-xl text-xs sm:text-sm transition-all shadow-md cursor-pointer">
        Done
      </button>
    </div>
  </div>
</div>

<script>
  const sectionsAnalysis = <%- JSON.stringify(course.Sections.reduce((acc, sec) => { acc[sec.id] = sec.analysis; return acc; }, {})) %>;
  
  function switchTab(tabId) {
    ['overview', 'topics', 'action'].forEach(t => {
      document.getElementById(`tab-content-${t}`).classList.add('hidden');
      document.getElementById(`tab-btn-${t}`).className = "py-3 px-4 text-xs font-bold text-slate-500 dark:text-slate-400 border-b-2 border-transparent transition-all cursor-pointer uppercase tracking-wider";
    });
    document.getElementById(`tab-content-${tabId}`).classList.remove('hidden');
    document.getElementById(`tab-btn-${tabId}`).className = "py-3 px-4 text-xs font-black border-b-2 border-indigo-600 text-indigo-600 dark:text-indigo-400 dark:border-indigo-400 transition-all cursor-pointer uppercase tracking-wider";
  }
  
  function openAnalysisModal(sectionId, sectionName) {
    const analysis = sectionsAnalysis[sectionId];
    if (!analysis) return;
    
    document.getElementById('modal-section-title').textContent = sectionName;
    document.getElementById('modal-teacher-name').textContent = analysis.teacher || 'Instructor';
    document.getElementById('modal-style-badge').textContent = analysis.style || 'Standard Style';
    document.getElementById('modal-desc').textContent = analysis.desc || '';
    document.getElementById('modal-structure').textContent = analysis.examStructure || '';
    document.getElementById('modal-persona').textContent = analysis.teacherPersona || '';
    
    const topicsContainer = document.getElementById('modal-topics-list');
    topicsContainer.innerHTML = '';
    analysis.importantTopics.forEach(topic => {
      let weightColor = 'bg-slate-100 text-slate-800 dark:bg-slate-700 dark:text-slate-200';
      if (topic.weight === 'Critical') {
        weightColor = 'bg-rose-100 text-rose-800 dark:bg-rose-950 dark:text-rose-200 border border-rose-200 dark:border-rose-900';
      } else if (topic.weight === 'Very High') {
        weightColor = 'bg-amber-100 text-amber-800 dark:bg-amber-950 dark:text-amber-200 border border-amber-200 dark:border-amber-900';
      } else if (topic.weight === 'High') {
        weightColor = 'bg-indigo-100 text-indigo-800 dark:bg-indigo-950 dark:text-indigo-200 border border-indigo-200 dark:border-indigo-900';
      }
      
      const topicEl = document.createElement('div');
      topicEl.className = 'border border-slate-200/80 dark:border-slate-700 p-4 rounded-xl bg-slate-50/50 dark:bg-slate-900/40';
      topicEl.innerHTML = `
        <div class="flex items-center justify-between gap-3 flex-wrap">
          <h4 class="font-bold text-sm text-slate-800 dark:text-slate-200">${topic.name}</h4>
          <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full ${weightColor}">${topic.weight}</span>
        </div>
        <div class="mt-2.5 space-y-2">
          <div>
            <span class="block text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider">Typical Questions</span>
            <span class="block text-xs text-slate-600 dark:text-slate-300 leading-relaxed">${topic.typicalQuestions}</span>
          </div>
          <div>
            <span class="block text-[9px] font-bold text-indigo-500 dark:text-indigo-400 uppercase tracking-wider">Scoring Secrets</span>
            <span class="block text-xs text-indigo-700 dark:text-indigo-300 leading-relaxed bg-indigo-50/50 dark:bg-indigo-950/30 p-2.5 rounded-lg border border-indigo-100 dark:border-indigo-900/40">${topic.scoringTips}</span>
          </div>
        </div>
      `;
      topicsContainer.appendChild(topicEl);
    });
    
    const trendsContainer = document.getElementById('modal-trends-list');
    trendsContainer.innerHTML = '';
    analysis.chronologicalTrends.forEach(trend => {
      const li = document.createElement('li');
      li.className = 'leading-relaxed';
      li.textContent = trend;
      trendsContainer.appendChild(li);
    });
    
    const tipsContainer = document.getElementById('modal-tips-list');
    tipsContainer.innerHTML = '';
    analysis.prepTips.forEach(tip => {
      const li = document.createElement('li');
      li.className = 'leading-relaxed';
      li.textContent = tip;
      tipsContainer.appendChild(li);
    });
    
    switchTab('overview');
    const modal = document.getElementById('analysis-modal');
    modal.classList.remove('hidden');
    setTimeout(() => {
      modal.classList.remove('opacity-0');
      modal.querySelector('.modal-content-panel').classList.remove('scale-95', 'opacity-0');
    }, 10);
  }
  
  function closeAnalysisModal() {
    const modal = document.getElementById('analysis-modal');
    modal.classList.add('opacity-0');
    modal.querySelector('.modal-content-panel').classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      modal.classList.add('hidden');
    }, 250);
  }
</script>

<%- include('partials/footer') %>
