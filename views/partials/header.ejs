<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> — Abir's Study Corner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
  <script>
    if (localStorage.getItem('theme') === 'dark' || (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
      document.documentElement.classList.add('dark');
    } else {
      document.documentElement.classList.remove('dark');
    }
  </script>
  <style>
    body {
      font-family: 'Inter', 'Hind Siliguri', -apple-system, BlinkMacSystemFont, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    .font-mono-code {
      font-family: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    }
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.3);
      border-radius: 3px;
    }
  </style>
  <script>
    window.MathJax = {
      tex: {
        inlineMath: [['$', '$'], ['\\(', '\\)']],
        displayMath: [['$$', '$$'], ['\\[', '\\]']],
        processEscapes: true
      },
      options: {
        skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre']
      }
    };
  </script>
  <script src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js" id="MathJax-script" async></script>
</head>
<body class="bg-[#fafafa] dark:bg-[#0a0a0c] text-slate-900 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-150">

  <%
    const currentTermId = locals.activeTerm || '4-1';
    const currentTermObj = locals.activeTermObj || { id: '4-1', name: 'Term 4-1', bnTitle: '৪র্থ বর্ষ ১ম টার্ম', status: 'current' };
    const allTermsList = locals.termsOverview || [];
  %>

  <!-- Minimalist Top Navigation -->
  <header class="bg-white/95 dark:bg-[#0f1014]/95 backdrop-blur-sm border-b border-slate-200 dark:border-slate-800/90 sticky top-0 z-40">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="flex items-center justify-between h-14 gap-4">
        
        <!-- Brand & Active Term Indicator -->
        <div class="flex items-center gap-4 min-w-0">
          <a href="/?term=<%= currentTermId %>" class="flex items-center gap-2.5 text-slate-900 dark:text-white font-semibold tracking-tight text-sm sm:text-base hover:opacity-80 transition-opacity truncate">
            <span>Abir's Study Corner</span>
          </a>

          <span class="text-slate-300 dark:text-slate-700 select-none">/</span>

          <button type="button" onclick="openTermModal()" class="inline-flex items-center gap-2 px-2.5 py-1 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-slate-400 dark:hover:border-slate-600 transition-colors cursor-pointer">
            <span class="font-mono-code font-semibold text-slate-900 dark:text-white"><%= currentTermId === 'all' ? 'ALL' : currentTermId %></span>
            <span class="text-slate-400 dark:text-slate-500 hidden sm:inline">
              <%= currentTermId === '4-1' ? 'Current' : currentTermId === '3-2' ? 'Archive' : 'Term' %>
            </span>
            <span class="text-[10px] text-slate-400">▾</span>
          </button>
        </div>

        <!-- Minimal Search Input -->
        <div class="flex-1 max-w-sm hidden md:block relative">
          <form action="/search" method="GET">
            <input type="text" name="q" id="global-search-input" autocomplete="off" placeholder="Search courses, topics, or questions..." 
              class="block w-full px-3 py-1.5 border border-slate-200 dark:border-slate-800 rounded-md bg-slate-50 dark:bg-slate-900/90 focus:outline-none focus:border-slate-400 dark:focus:border-slate-600 text-xs text-slate-800 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 transition-colors">
          </form>
          <div id="search-results-dropdown" class="absolute left-0 right-0 mt-1.5 w-full bg-white dark:bg-[#121318] rounded-md shadow-lg border border-slate-200 dark:border-slate-800 max-h-80 overflow-y-auto hidden z-50"></div>
        </div>

        <!-- Right Controls -->
        <div class="flex items-center gap-2">
          <button type="button" onclick="openTermModal()" class="px-2.5 py-1.5 rounded-md text-xs font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:bg-slate-100 dark:hover:bg-slate-900 transition-colors cursor-pointer">
            Switch Term
          </button>

          <button id="theme-toggle" class="px-2.5 py-1.5 rounded-md text-xs font-medium border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white hover:border-slate-300 dark:hover:border-slate-700 transition-colors cursor-pointer" aria-label="Toggle theme">
            <span class="hidden dark:inline">Light</span>
            <span class="inline dark:hidden">Dark</span>
          </button>
        </div>

      </div>
    </div>
  </header>

  <!-- Minimalist Academic Term Selector Modal (1-1 to 4-2) -->
  <div id="term-selector-modal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-[2px] transition-opacity duration-200 <%= locals.showTermPrompt ? '' : 'hidden opacity-0' %>" role="dialog" aria-modal="true" aria-labelledby="term-portal-title">
    <div class="fixed inset-0" onclick="closeTermModal()"></div>

    <div id="term-selector-panel" class="relative w-full max-w-2xl bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg shadow-xl overflow-hidden z-10 max-h-[90vh] flex flex-col transition-all duration-200 <%= locals.showTermPrompt ? 'scale-100 opacity-100' : 'scale-95 opacity-0' %>">
      
      <!-- Modal Header -->
      <div class="px-6 py-5 border-b border-slate-200 dark:border-slate-800 flex items-start justify-between gap-4">
        <div>
          <p class="text-[11px] font-mono-code uppercase tracking-wider text-slate-400 dark:text-slate-500">
            B.Sc. Agriculture • Academic Semesters
          </p>
          <h2 id="term-portal-title" class="text-lg sm:text-xl font-semibold text-slate-900 dark:text-white mt-1">
            Select Academic Term (1-1 to 4-2)
          </h2>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            কোন টার্মের পড়াশোনা করতে চাও সিলেক্ট করো। আগের টার্ম ছিল <span class="font-mono-code font-medium text-slate-700 dark:text-slate-300">3-2</span> এবং চলমান টার্ম <span class="font-mono-code font-medium text-slate-900 dark:text-white">4-1</span>।
          </p>
        </div>

        <button type="button" onclick="closeTermModal()" class="text-xs font-medium text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 px-2 py-1 rounded border border-transparent hover:border-slate-200 dark:hover:border-slate-800 cursor-pointer">
          ESC
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-6 flex-1">
        
        <!-- Primary Quick Selection: 4-1 (Current) & 3-2 (Previous Archive) -->
        <%
          const term41 = allTermsList.find(t => t.id === '4-1') || { id: '4-1', coursesCount: 0, questionsCount: 0 };
          const term32 = allTermsList.find(t => t.id === '3-2') || { id: '3-2', coursesCount: 5, questionsCount: 454 };
        %>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="/?term=4-1" class="block p-4 rounded-md border transition-colors <%= currentTermId === '4-1' ? 'border-slate-900 dark:border-white bg-slate-50 dark:bg-slate-900/80' : 'border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600' %>">
            <div class="flex items-center justify-between">
              <span class="font-mono-code text-base font-semibold text-slate-900 dark:text-white">Term 4-1</span>
              <span class="text-[10px] font-mono-code uppercase px-2 py-0.5 rounded bg-slate-900 text-white dark:bg-white dark:text-slate-900 font-medium">
                Current Term
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              ৪র্থ বর্ষ ১ম টার্ম (চলমান) &bull; 4100 Series
            </p>
            <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400">
              <span><%= term41.coursesCount > 0 ? `${term41.coursesCount} Courses` : 'Active Semester' %></span>
              <span>Enter &rarr;</span>
            </div>
          </a>

          <a href="/?term=3-2" class="block p-4 rounded-md border transition-colors <%= currentTermId === '3-2' ? 'border-slate-900 dark:border-white bg-slate-50 dark:bg-slate-900/80' : 'border-slate-200 dark:border-slate-800 hover:border-slate-400 dark:hover:border-slate-600' %>">
            <div class="flex items-center justify-between">
              <span class="font-mono-code text-base font-semibold text-slate-900 dark:text-white">Term 3-2</span>
              <span class="text-[10px] font-mono-code uppercase px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 font-medium">
                Previous Term
              </span>
            </div>
            <p class="text-xs text-slate-500 dark:text-slate-400 mt-1.5">
              ৩য় বর্ষ ২য় টার্ম (আগের টার্ম) &bull; 3200 Series
            </p>
            <div class="mt-3 pt-2.5 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs text-slate-600 dark:text-slate-400">
              <span><%= term32.coursesCount %> Courses &bull; <%= term32.questionsCount %> Q&As</span>
              <span>Open Archive &rarr;</span>
            </div>
          </a>
        </div>

        <!-- All 8 Semesters Grid (1-1 to 4-2) -->
        <div>
          <div class="text-[11px] font-mono-code uppercase tracking-wider text-slate-400 dark:text-slate-500 mb-2.5">
            All Semesters (1-1 to 4-2)
          </div>
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
            <% allTermsList.forEach(t => { 
                 const isSelected = currentTermId === t.id;
            %>
              <a href="/?term=<%= t.id %>" class="p-3 rounded-md border transition-colors flex flex-col justify-between <%= isSelected ? 'border-slate-900 dark:border-white bg-slate-50 dark:bg-slate-900' : 'border-slate-200 dark:border-slate-800/90 hover:border-slate-400 dark:hover:border-slate-600' %>">
                <div>
                  <div class="flex items-center justify-between">
                    <span class="font-mono-code text-sm font-semibold text-slate-900 dark:text-white"><%= t.id %></span>
                    <% if (t.id === '4-1') { %>
                      <span class="text-[10px] font-mono-code text-slate-500 dark:text-slate-400">Now</span>
                    <% } else if (t.coursesCount > 0) { %>
                      <span class="text-[10px] font-mono-code text-slate-500 dark:text-slate-400"><%= t.coursesCount %>c</span>
                    <% } %>
                  </div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400 mt-1">
                    Year <%= t.year %>, Term <%= t.semester %>
                  </div>
                </div>
                <div class="mt-2 pt-1.5 border-t border-slate-100 dark:border-slate-800/60 text-[10px] font-mono-code text-slate-400 dark:text-slate-500">
                  <%= t.coursesCount > 0 ? `${t.questionsCount} Q&As` : t.codeSeries %>
                </div>
              </a>
            <% }) %>
          </div>
        </div>

      </div>

      <!-- Modal Footer -->
      <div class="px-6 py-3.5 bg-slate-50 dark:bg-[#0d0e12] border-t border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs">
        <a href="/?term=all" class="font-medium text-slate-600 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white transition-colors">
          View all semesters combined &rarr;
        </a>
        <button type="button" onclick="closeTermModal()" class="px-3 py-1.5 rounded border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 hover:border-slate-400 transition-colors cursor-pointer">
          Close
        </button>
      </div>

    </div>
  </div>

  <script>
    function openTermModal() {
      const modal = document.getElementById('term-selector-modal');
      const panel = document.getElementById('term-selector-panel');
      if (!modal || !panel) return;
      modal.classList.remove('hidden');
      setTimeout(() => {
        modal.classList.remove('opacity-0');
        panel.classList.remove('scale-95', 'opacity-0');
        panel.classList.add('scale-100', 'opacity-100');
      }, 10);
    }

    function closeTermModal() {
      const modal = document.getElementById('term-selector-modal');
      const panel = document.getElementById('term-selector-panel');
      if (!modal || !panel) return;
      modal.classList.add('opacity-0');
      panel.classList.remove('scale-100', 'opacity-100');
      panel.classList.add('scale-95', 'opacity-0');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }
  </script>

  <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 py-8">
