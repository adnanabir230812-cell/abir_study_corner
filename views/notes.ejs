<%- include('partials/header') %>

<!-- Breadcrumb -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3 text-xs">
  <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
    <a href="/?term=<%= course.term || '3-2' %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
      Term <%= course.term || '3-2' %>
    </a>
    <span>/</span>
    <a href="/courses/<%= course.id %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
      <%= course.name %> (<%= course.code %>)
    </a>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-medium">Notes</span>
  </div>
  <span class="font-mono-code text-slate-400 dark:text-slate-500">
    <%= section.name %>
  </span>
</div>

<!-- Header -->
<div class="mb-6">
  <div class="text-xs font-mono-code text-slate-400 dark:text-slate-500">
    <%= course.code %> &bull; Term <%= course.term || '3-2' %> &bull; <%= section.teacherName || 'Instructor' %>
  </div>
  <h1 class="text-2xl sm:text-3xl font-semibold text-slate-900 dark:text-white mt-1 tracking-tight">
    <%= course.name %> &mdash; Course Notes
  </h1>
</div>

<!-- Notes Container -->
<div class="bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6 md:p-10">
  <% if (note) { %>
    <div class="markdown-content text-slate-700 dark:text-slate-300 text-base leading-relaxed">
      <%- note.parsedContent %>
    </div>
  <% } else { %>
    <div class="py-10 text-center text-xs text-slate-400 dark:text-slate-500">
      No notes uploaded for this section yet.
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
