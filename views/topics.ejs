<%- include('partials/header') %>

<div class="mb-6 text-xs text-slate-500 dark:text-slate-400">
  <a href="/courses/<%= course.id %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
    &larr; Back to <%= course.name %> (<%= course.code %>)
  </a>
</div>

<div class="mb-8">
  <div class="text-xs font-mono-code text-slate-400 dark:text-slate-500">
    <%= course.code %> &bull; Term <%= course.term || '3-2' %> &bull; <%= section.name %>
  </div>
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-white mt-1 tracking-tight">Topic-Wise Questions</h1>
</div>

<div class="space-y-6">
  <% if (topics && topics.length > 0) { %>
    <% topics.forEach((topic, idx) => { %>
      <div class="bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6">
        <h2 class="text-base font-semibold text-slate-900 dark:text-white mb-4 flex items-center gap-2">
          <span class="font-mono-code text-xs text-slate-400"><%= String(idx + 1).padStart(2, '0') %>.</span>
          <span><%= topic.name %></span>
        </h2>

        <% if (topic.Questions && topic.Questions.length > 0) { %>
          <div class="divide-y divide-slate-100 dark:divide-slate-800">
            <% topic.Questions.forEach((question, qIdx) => { %>
              <div class="py-3 first:pt-0 last:pb-0 flex items-start justify-between gap-4 text-sm">
                <div class="flex items-start gap-3">
                  <span class="font-mono-code text-xs text-slate-400 mt-0.5"><%= idx + 1 %>.<%= qIdx + 1 %></span>
                  <p class="text-slate-700 dark:text-slate-200">
                    <%= question.questionText %>
                  </p>
                </div>
                <a href="/courses/<%= course.id %>/qa?sec=<%= section.id %>#item-<%= question.id %>" class="flex-shrink-0 text-xs font-mono-code text-slate-500 hover:text-slate-900 dark:hover:text-white">
                  Answer &rarr;
                </a>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="text-xs text-slate-400">No questions loaded for this topic.</p>
        <% } %>
      </div>
    <% }) %>
  <% } else { %>
    <div class="bg-white dark:bg-[#111217] rounded-lg p-10 text-center border border-slate-200 dark:border-slate-800 text-xs text-slate-400">
      No topics defined in this section.
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
