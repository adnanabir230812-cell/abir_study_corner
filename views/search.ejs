<%- include('partials/header') %>

<div class="mb-6 text-xs text-slate-500 dark:text-slate-400">
  <a href="/?term=<%= locals.activeTerm || '4-1' %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
    &larr; Back to Dashboard
  </a>
</div>

<div class="mb-8">
  <h1 class="text-2xl font-semibold text-slate-900 dark:text-white tracking-tight">Search Results</h1>
  <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Showing matches for "<%= query %>"</p>
</div>

<div class="space-y-8">
  <% if (results.courses && results.courses.length > 0) { %>
    <div>
      <h2 class="text-xs font-mono-code text-slate-400 uppercase tracking-wider mb-3">Courses (<%= results.courses.length %>)</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        <% results.courses.forEach(c => { %>
          <a href="/courses/<%= c.id %>" class="block bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-4 hover:border-slate-400 transition-colors">
            <div class="flex items-center justify-between text-xs font-mono-code text-slate-400 mb-1">
              <span><%= c.code %></span>
              <span>Term <%= c.term || '3-2' %></span>
            </div>
            <h3 class="font-semibold text-slate-900 dark:text-white text-sm"><%= c.name %></h3>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (results.topics && results.topics.length > 0) { %>
    <div>
      <h2 class="text-xs font-mono-code text-slate-400 uppercase tracking-wider mb-3">Topics (<%= results.topics.length %>)</h2>
      <div class="space-y-2.5">
        <% results.topics.forEach(t => { %>
          <a href="/courses/<%= t.Section.courseId %>/qa?sec=<%= t.Section.id %>#topic-<%= t.id %>" class="block bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-4 hover:border-slate-400 transition-colors">
            <div class="flex items-center justify-between gap-2">
              <h3 class="font-medium text-slate-900 dark:text-white text-sm"><%= t.name %></h3>
              <span class="text-xs font-mono-code text-slate-400">Term <%= t.Section.Course.term || '3-2' %></span>
            </div>
            <p class="text-xs text-slate-500 mt-1"><%= t.Section.Course.name %> (<%= t.Section.Course.code %>) &bull; <%= t.Section.name %></p>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if (results.questions && results.questions.length > 0) { %>
    <div>
      <h2 class="text-xs font-mono-code text-slate-400 uppercase tracking-wider mb-3">Questions (<%= results.questions.length %>)</h2>
      <div class="space-y-2.5">
        <% results.questions.forEach(q => { %>
          <a href="/courses/<%= q.Topic.Section.courseId %>/qa?sec=<%= q.Topic.Section.id %>&question=<%= q.id %>#item-<%= q.id %>" class="block bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-4 hover:border-slate-400 transition-colors">
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-medium text-slate-900 dark:text-slate-100 text-sm"><%= q.questionText %></h3>
              <span class="flex-shrink-0 text-xs font-mono-code text-slate-400">Term <%= q.Topic.Section.Course.term || '3-2' %></span>
            </div>
            <p class="text-xs text-slate-500 mt-1"><%= q.Topic.Section.Course.name %> &bull; <%= q.Topic.Section.name %> &bull; <%= q.Topic.name %></p>
          </a>
        <% }) %>
      </div>
    </div>
  <% } %>

  <% if ((!results.courses || results.courses.length === 0) && (!results.topics || results.topics.length === 0) && (!results.questions || results.questions.length === 0)) { %>
    <div class="bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-10 text-center text-xs text-slate-500">
      No matches found for "<%= query %>".
    </div>
  <% } %>
</div>

<%- include('partials/footer') %>
