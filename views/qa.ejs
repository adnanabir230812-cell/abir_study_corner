<%- include('partials/header') %>

<!-- Breadcrumb -->
<div class="mb-6 flex items-center justify-between flex-wrap gap-3 text-xs">
  <div class="flex items-center gap-2 text-slate-500 dark:text-slate-400">
    <a href="/?term=<%= course.term || '3-2' %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
      Term <%= course.term || '3-2' %>
    </a>
    <span>/</span>
    <a href="/courses/<%= course.id %>" class="hover:text-slate-900 dark:hover:text-white transition-colors">
      <%= course.name %> (<%= course.code %>)
    </a>
    <span>/</span>
    <span class="text-slate-900 dark:text-white font-medium"><%= section.name %></span>
  </div>
  <span class="font-mono-code text-slate-400 dark:text-slate-500">
    <%= section.solvedCount %>/<%= section.totalCount %> solved
  </span>
</div>

<!-- Header & Controls -->
<div class="bg-white dark:bg-[#111217] border border-slate-200 dark:border-slate-800 rounded-lg p-6 mb-8">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6">
    <div>
      <div class="text-xs font-mono-code text-slate-400 dark:text-slate-500">
        <%= course.code %> &bull; Term <%= course.term || '3-2' %> &bull; <%= section.teacherName || 'Instructor' %>
      </div>
      <h1 class="text-2xl font-semibold text-slate-900 dark:text-white mt-1 tracking-tight">
        <%= course.name %> &mdash; <%= section.name %>
      </h1>
    </div>
    
    <div class="min-w-[220px]">
      <div class="flex justify-between items-center text-xs font-mono-code text-slate-500 dark:text-slate-400 mb-1.5">
        <span>Progress</span>
        <span class="progress-text"><%= section.solvedCount %>/<%= section.totalCount %> (<%= section.percentage %>%)</span>
      </div>
      <div class="w-full bg-slate-100 dark:bg-slate-800 h-1 rounded-full overflow-hidden">
        <div class="bg-slate-900 dark:bg-white h-full transition-all duration-300 progress-bar-fill" style="width: <%= section.percentage %>%"></div>
      </div>
    </div>
  </div>

  <!-- Filter & Accordion Controls -->
  <div class="mt-5 pt-4 border-t border-slate-100 dark:border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
    <div class="flex-1 max-w-sm">
      <input type="text" id="qa-local-filter" placeholder="Filter questions..." 
        class="w-full px-3 py-1.5 text-xs rounded border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 focus:outline-none focus:border-slate-400">
    </div>

    <div class="flex items-center gap-2">
      <button type="button" onclick="toggleAllAccordions(true)" class="px-3 py-1.5 rounded text-xs font-medium border border-slate-200 dark:border-slate-800 text-slate-700 dark:text-slate-300 hover:border-slate-400 transition-colors cursor-pointer">
        Expand All
      </button>
      <button type="button" onclick="toggleAllAccordions(false)" class="px-3 py-1.5 rounded text-xs font-medium border border-slate-200 dark:border-slate-800 text-slate-600 dark:text-slate-400 hover:border-slate-400 transition-colors cursor-pointer">
        Collapse All
      </button>
    </div>
  </div>
</div>

<!-- Topics & Questions Accordion -->
<div class="space-y-8">
  <% if (topics && topics.length > 0) { %>
    <% topics.forEach((topic, tIdx) => { %>
      <div id="topic-<%= topic.id %>" class="scroll-mt-20">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-3 flex items-center gap-2">
          <span class="font-mono-code"><%= String(tIdx + 1).padStart(2, '0') %>.</span>
          <span><%= topic.name %></span>
        </h2>

        <% if (topic.Questions && topic.Questions.length > 0) { %>
          <div class="divide-y divide-slate-200 dark:divide-slate-800 border border-slate-200 dark:border-slate-800 bg-white dark:bg-[#111217] rounded-lg overflow-hidden">
            <% topic.Questions.forEach((question) => { %>
              <div class="accordion-item" id="item-<%= question.id %>" data-question-text="<%= question.questionText.toLowerCase() %>">
                
                <div class="accordion-header flex items-center justify-between p-4 cursor-pointer select-none gap-4 hover:bg-slate-50/70 dark:hover:bg-slate-900/50 transition-colors">
                  <div class="flex items-start gap-3.5 flex-1">
                    <input type="checkbox" 
                      class="solved-checkbox mt-1 h-4 w-4 rounded border-slate-300 dark:border-slate-700 accent-slate-900 dark:accent-white cursor-pointer" 
                      data-question-id="<%= question.id %>"
                      data-section-id="<%= section.id %>"
                      onclick="event.stopPropagation()"
                      <%= (question.Progress && question.Progress.solved) ? 'checked' : '' %>>
                    
                    <span class="font-medium text-slate-900 dark:text-slate-100 text-sm sm:text-base leading-relaxed">
                      <%= question.questionText %>
                    </span>
                  </div>

                  <span class="accordion-icon text-xs font-mono-code text-slate-400 transition-transform duration-200 flex-shrink-0">▾</span>
                </div>

                <div class="accordion-content max-h-0 overflow-hidden bg-slate-50/40 dark:bg-[#0d0e12] transition-all duration-200">
                  <div class="p-5 border-t border-slate-100 dark:border-slate-800/80">
                    <div class="markdown-content text-slate-700 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
                      <%- question.parsedAnswer %>
                    </div>
                  </div>
                </div>

              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="p-4 border border-slate-200 dark:border-slate-800 rounded-lg text-xs text-slate-400">
            No questions defined under this topic.
          </div>
        <% } %>
      </div>
    <% }) %>
  <% } else { %>
    <div class="bg-white dark:bg-[#111217] rounded-lg p-10 text-center border border-slate-200 dark:border-slate-800">
      <h3 class="text-sm font-semibold text-slate-800 dark:text-white">No topics available</h3>
    </div>
  <% } %>
</div>

<script>
  const localFilterInput = document.getElementById('qa-local-filter');
  if (localFilterInput) {
    localFilterInput.addEventListener('input', (e) => {
      const q = e.target.value.trim().toLowerCase();
      document.querySelectorAll('.accordion-item').forEach(item => {
        const text = item.getAttribute('data-question-text') || '';
        item.style.display = (!q || text.includes(q)) ? '' : 'none';
      });
    });
  }

  function toggleAllAccordions(expand) {
    document.querySelectorAll('.accordion-item').forEach(item => {
      const content = item.querySelector('.accordion-content');
      const icon = item.querySelector('.accordion-icon');
      if (!content) return;
      if (expand) {
        content.classList.add('open');
        content.style.maxHeight = content.scrollHeight + 500 + 'px';
        if (icon) icon.classList.add('rotate-180');
      } else {
        content.classList.remove('open');
        content.style.maxHeight = null;
        if (icon) icon.classList.remove('rotate-180');
      }
    });
  }
</script>

<script src="/js/qa.js"></script>

<%- include('partials/footer') %>
